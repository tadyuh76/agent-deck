diff --git a/internal/session/native_title.go b/internal/session/native_title.go
new file mode 100644
index 0000000..6127424
--- /dev/null
+++ b/internal/session/native_title.go
@@ -0,0 +1,364 @@
+package session
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+)
+
+// NativeConversation is what the agent itself recorded about a conversation:
+// the title it shows in its own apps, and whether anything was ever said.
+type NativeConversation struct {
+	Title string
+	// LimitedAt is when the latest reply was a plan-limit rejection (zero when
+	// the conversation was not stopped by a limit); LimitResets is Claude's own
+	// wording of when the limit lifts, e.g. "3:30pm" or "Oct 5 at 6am".
+	LimitedAt   time.Time
+	LimitResets string
+	// Changed is when the conversation itself last changed (a message sent or
+	// received), unlike screen activity, which a status line refreshes.
+	Changed time.Time
+	// Known is false when the transcript could not be located or read, so a
+	// caller must not mistake "unknown" for "empty".
+	Known bool
+	Empty bool
+}
+
+// NativeConversationInput is the plain-data view of an Instance the resolver
+// needs, gathered on the caller's goroutine so resolution can run elsewhere.
+type NativeConversationInput struct {
+	Tool            string
+	ProjectPath     string
+	WorkingDir      string
+	ClaudeConfigDir string
+	ClaudeSessionID string
+	CodexHome       string
+	CodexSessionID  string
+}
+
+// NativeConversationInputFor snapshots the fields NativeConversationFor reads.
+func NativeConversationInputFor(inst *Instance) NativeConversationInput {
+	input := NativeConversationInput{Tool: inst.Tool, ProjectPath: inst.ProjectPath, WorkingDir: inst.EffectiveWorkingDir()}
+	switch {
+	case IsClaudeCompatible(inst.Tool):
+		input.ClaudeConfigDir = GetClaudeConfigDirForInstance(inst)
+		input.ClaudeSessionID = inst.ClaudeSessionID
+	case IsCodexCompatible(inst.Tool):
+		input.CodexHome = CodexHomeDirForInstance(inst)
+		input.CodexSessionID = inst.CodexSessionID
+	}
+	return input
+}
+
+// NativeConversationFor reads the conversation's own title: a name the user
+// gave it with /rename, otherwise the title Claude generates for its apps, or
+// the Codex thread name. Files are re-read only from where they last ended.
+func NativeConversationFor(input NativeConversationInput) NativeConversation {
+	switch {
+	case input.ClaudeSessionID != "":
+		return claudeNativeConversation(input)
+	case input.CodexHome != "":
+		if input.CodexSessionID == "" {
+			return NativeConversation{Known: true, Empty: true}
+		}
+		title, changed := codexThread(input.CodexHome, input.CodexSessionID)
+		return NativeConversation{Title: title, Known: true, Changed: changed}
+	case IsClaudeCompatible(input.Tool):
+		// Claude writes no transcript until the first message is sent.
+		return NativeConversation{Known: true, Empty: true}
+	}
+	return NativeConversation{}
+}
+
+type claudeTranscriptScan struct {
+	path        string
+	offset      int64
+	tail        []byte
+	customTitle string
+	aiTitle     string
+	hasPrompt   bool
+	limitedAt   time.Time
+	limitResets string
+	changed     time.Time
+}
+
+var (
+	claudeScanMu sync.Mutex
+	claudeScans  = map[string]*claudeTranscriptScan{}
+)
+
+func claudeNativeConversation(input NativeConversationInput) NativeConversation {
+	claudeScanMu.Lock()
+	scan := claudeScans[input.ClaudeSessionID]
+	claudeScanMu.Unlock()
+
+	if scan == nil || !regularFile(scan.path) {
+		path := ResolveClaudeTranscriptPath(input.ClaudeConfigDir, input.ProjectPath, input.ClaudeSessionID, input.WorkingDir)
+		if path == "" {
+			return NativeConversation{Known: true, Empty: true}
+		}
+		scan = &claudeTranscriptScan{path: path}
+	}
+	if err := scan.advance(); err != nil {
+		return NativeConversation{}
+	}
+	claudeScanMu.Lock()
+	claudeScans[input.ClaudeSessionID] = scan
+	claudeScanMu.Unlock()
+
+	title := scan.customTitle
+	if title == "" {
+		title = scan.aiTitle
+	}
+	return NativeConversation{Title: title, Known: true, Empty: !scan.hasPrompt, LimitedAt: scan.limitedAt, LimitResets: scan.limitResets, Changed: scan.changed}
+}
+
+func regularFile(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && info.Mode().IsRegular()
+}
+
+var (
+	titleRowMarkers    = [][]byte{[]byte(`"type":"ai-title"`), []byte(`"type":"custom-title"`)}
+	userRowMarker      = []byte(`"type":"user"`)
+	assistantRowMarker = []byte(`"type":"assistant"`)
+	apiErrorMarker     = []byte(`"isApiErrorMessage":true`)
+	limitResetsPattern = regexp.MustCompile(`resets ([^(]+?)\s*(?:\(|$)`)
+)
+
+// Claude re-appends its title rows as a conversation goes on, so the first
+// read only needs the end of a long transcript.
+const (
+	transcriptTailWindow = 1 << 20
+	transcriptHeadWindow = 256 << 10
+)
+
+func (s *claudeTranscriptScan) advance() error {
+	file, err := os.Open(s.path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return err
+	}
+	s.changed = info.ModTime()
+	size := info.Size()
+	if size < s.offset {
+		*s = claudeTranscriptScan{path: s.path}
+	}
+	if size == s.offset {
+		return nil
+	}
+	first := s.offset == 0
+	skipPartial := false
+	if first && size > transcriptTailWindow {
+		s.offset = size - transcriptTailWindow
+		skipPartial = true
+	}
+	if err := s.read(file, skipPartial); err != nil {
+		return err
+	}
+	if first && !s.hasPrompt && s.customTitle == "" && s.aiTitle == "" && size > transcriptTailWindow {
+		// The opening prompt is near the top; anything this long was used.
+		head := claudeTranscriptScan{path: s.path}
+		if _, err := file.Seek(0, io.SeekStart); err == nil {
+			head.readLimited(io.LimitReader(file, transcriptHeadWindow))
+		}
+		s.hasPrompt = head.hasPrompt || size > transcriptTailWindow+transcriptHeadWindow
+	}
+	if s.customTitle != "" || s.aiTitle != "" {
+		s.hasPrompt = true
+	}
+	return nil
+}
+
+func (s *claudeTranscriptScan) read(file *os.File, skipPartial bool) error {
+	if _, err := file.Seek(s.offset, io.SeekStart); err != nil {
+		return err
+	}
+	reader := bufio.NewReaderSize(file, 256*1024)
+	for {
+		line, err := reader.ReadBytes('\n')
+		s.offset += int64(len(line))
+		if err != nil {
+			// Keep a partial last line until Claude finishes writing it.
+			s.tail = append(s.tail, line...)
+			if err == io.EOF {
+				return nil
+			}
+			return err
+		}
+		if skipPartial {
+			skipPartial = false
+			continue
+		}
+		if len(s.tail) > 0 {
+			line = append(s.tail, line...)
+			s.tail = nil
+		}
+		s.consume(line)
+	}
+}
+
+func (s *claudeTranscriptScan) readLimited(r io.Reader) {
+	reader := bufio.NewReaderSize(r, 256*1024)
+	for !s.hasPrompt {
+		line, err := reader.ReadBytes('\n')
+		if err != nil {
+			return
+		}
+		s.consume(line)
+	}
+}
+
+func (s *claudeTranscriptScan) consume(line []byte) {
+	// Only the latest reply decides whether a limit stopped the conversation.
+	if bytes.Contains(line, assistantRowMarker) {
+		s.limitedAt, s.limitResets = time.Time{}, ""
+		if bytes.Contains(line, apiErrorMarker) {
+			var reply struct {
+				Timestamp time.Time `json:"timestamp"`
+				Error     string    `json:"error"`
+				Message   struct {
+					Content []struct {
+						Text string `json:"text"`
+					} `json:"content"`
+				} `json:"message"`
+			}
+			if json.Unmarshal(line, &reply) == nil && reply.Error == "rate_limit" && !reply.Timestamp.IsZero() {
+				s.limitedAt = reply.Timestamp
+				for _, part := range reply.Message.Content {
+					if match := limitResetsPattern.FindStringSubmatch(part.Text); match != nil {
+						s.limitResets = strings.TrimSpace(match[1])
+					}
+				}
+			}
+		}
+		return
+	}
+	isTitle := bytes.Contains(line, titleRowMarkers[0]) || bytes.Contains(line, titleRowMarkers[1])
+	isUser := !s.hasPrompt && bytes.Contains(line, userRowMarker)
+	if !isTitle && !isUser {
+		return
+	}
+	var row struct {
+		Type        string          `json:"type"`
+		AITitle     string          `json:"aiTitle"`
+		CustomTitle string          `json:"customTitle"`
+		IsMeta      bool            `json:"isMeta"`
+		Message     json.RawMessage `json:"message"`
+	}
+	if json.Unmarshal(line, &row) != nil {
+		return
+	}
+	switch row.Type {
+	case "ai-title":
+		if title := cleanNativeTitle(row.AITitle); title != "" {
+			s.aiTitle = title
+		}
+	case "custom-title":
+		title := cleanNativeTitle(row.CustomTitle)
+		if PlaceholderSessionTitle(title) {
+			title = ""
+		}
+		s.customTitle = title
+	case "user":
+		if !row.IsMeta && len(row.Message) > 0 {
+			s.hasPrompt = true
+		}
+	}
+}
+
+type codexThreadEntry struct {
+	name    string
+	updated time.Time
+}
+
+type codexIndex struct {
+	size    int64
+	threads map[string]codexThreadEntry
+}
+
+var (
+	codexIndexMu sync.Mutex
+	codexIndexes = map[string]*codexIndex{}
+)
+
+func codexThread(home, id string) (string, time.Time) {
+	path := filepath.Join(home, "session_index.jsonl")
+	info, err := os.Stat(path)
+	if err != nil {
+		return "", time.Time{}
+	}
+	codexIndexMu.Lock()
+	defer codexIndexMu.Unlock()
+	index := codexIndexes[home]
+	if index == nil || index.size != info.Size() {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return "", time.Time{}
+		}
+		index = &codexIndex{size: info.Size(), threads: map[string]codexThreadEntry{}}
+		for _, line := range bytes.Split(data, []byte("\n")) {
+			var row struct {
+				ID         string    `json:"id"`
+				ThreadName string    `json:"thread_name"`
+				UpdatedAt  time.Time `json:"updated_at"`
+			}
+			if json.Unmarshal(line, &row) == nil && row.ID != "" {
+				entry := index.threads[row.ID]
+				if name := cleanNativeTitle(row.ThreadName); name != "" {
+					entry.name = name
+				}
+				if row.UpdatedAt.After(entry.updated) {
+					entry.updated = row.UpdatedAt
+				}
+				index.threads[row.ID] = entry
+			}
+		}
+		codexIndexes[home] = index
+	}
+	entry := index.threads[id]
+	return entry.name, entry.updated
+}
+
+func cleanNativeTitle(value string) string {
+	value = strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) {
+			return ' '
+		}
+		return r
+	}, value)
+	return strings.Join(strings.Fields(value), " ")
+}
+
+var placeholderTitlePatterns = []*regexp.Regexp{
+	regexp.MustCompile(`^New conversation(?: \(\d+\))?$`),
+	// Launcher stamps such as "Work · 10:53" or "Personal · 23:26".
+	regexp.MustCompile(`^[\p{L}\p{N}_ -]+ · \d{2}:\d{2}`),
+}
+
+// PlaceholderSessionTitle reports titles a launcher stamped on a conversation
+// before anyone said anything, which a real conversation title replaces.
+func PlaceholderSessionTitle(title string) bool {
+	title = strings.TrimSpace(title)
+	if title == "" {
+		return true
+	}
+	for _, pattern := range placeholderTitlePatterns {
+		if pattern.MatchString(title) {
+			return true
+		}
+	}
+	return false
+}
