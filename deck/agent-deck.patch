diff --git a/internal/ui/recent_view.go b/internal/ui/recent_view.go
new file mode 100644
index 0000000..cd51e2d
--- /dev/null
+++ b/internal/ui/recent_view.go
@@ -0,0 +1,528 @@
+package ui
+
+import (
+	"fmt"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/charmbracelet/lipgloss"
+
+	"github.com/asheshgoplani/agent-deck/internal/session"
+)
+
+// The Recent view mirrors the Claude desktop sidebar: conversations that need
+// you come first, then the ones still working, then everything else by when
+// it last changed.
+type recentSection int
+
+const (
+	recentNeedsYou recentSection = iota
+	recentWorking
+	recentPast
+)
+
+func (s recentSection) label() string {
+	switch s {
+	case recentNeedsYou:
+		return "Needs you"
+	case recentWorking:
+		return "Working"
+	default:
+		return "Recent"
+	}
+}
+
+func needsYouSubstate(substate session.Substate) bool {
+	return substate == session.SubstateInteractiveMenu || substate == session.SubstateAuth401
+}
+
+// A limit that stopped a conversation keeps it under "Needs you" this long.
+const limitAttentionWindow = 12 * time.Hour
+
+type conversationLimit struct {
+	at     time.Time
+	resets string
+}
+
+func (l conversationLimit) recent() bool {
+	return l.at.IsZero() || time.Since(l.at) < limitAttentionWindow
+}
+
+// limitFor reports a plan limit that stopped this conversation. Claude's comes
+// from its transcript and only counts after this session started, since a chat
+// moved to another account shares the transcript of the one that stopped;
+// Codex shows its limit on screen.
+func (h *Home) limitFor(inst *session.Instance, substate session.Substate) (conversationLimit, bool) {
+	if inst.IsArchived() {
+		return conversationLimit{}, false
+	}
+	if limit, ok := h.conversationLimits[inst.ID]; ok {
+		return limit, true
+	}
+	if substate == session.SubstateUsageLimit && !session.IsClaudeCompatible(inst.Tool) {
+		return conversationLimit{}, true
+	}
+	return conversationLimit{}, false
+}
+
+// A finished conversation nobody opened stops asking for attention after this.
+const unreadDoneWindow = 12 * time.Hour
+
+func (h *Home) recentSectionFor(inst *session.Instance, activity time.Time) recentSection {
+	if inst.IsArchived() {
+		return recentPast
+	}
+	substate := inst.CachedSubstate()
+	if limit, limited := h.limitFor(inst, substate); limited && limit.recent() {
+		return recentNeedsYou
+	}
+	if needsYouSubstate(substate) {
+		return recentNeedsYou
+	}
+	switch inst.GetStatusThreadSafe() {
+	case session.StatusWaiting:
+		if !h.unreadDone(inst.ID) || time.Since(activity) > unreadDoneWindow {
+			return recentPast
+		}
+		return recentNeedsYou
+	case session.StatusRunning, session.StatusStarting:
+		return recentWorking
+	}
+	return recentPast
+}
+
+// sessionActivity is when a conversation last changed: its transcript when
+// known, so a chat sitting in a panel does not climb the list as its screen
+// refreshes; Agent Deck's own activity time otherwise.
+func (h *Home) sessionActivity(inst *session.Instance) time.Time {
+	if changed, ok := h.conversationChanged[inst.ID]; ok {
+		return changed
+	}
+	var hookStatus *session.HookStatus
+	if h.hookWatcher != nil {
+		hookStatus = h.hookWatcher.GetHookStatus(inst.ID)
+	}
+	confirmed, observed := inst.LastObservedActivity()
+	return sessionActivityTime(inst.CreatedAt, inst.LastStartedAt, inst.LastActivityAt(), inst.LastAccessedAt, confirmed, observed, hookStatus)
+}
+
+// sectionRecentItems orders the filtered Recent list into labelled sections
+// and leaves out conversations nobody ever typed into.
+func (h *Home) sectionRecentItems(items []session.Item) []session.Item {
+	type entry struct {
+		rows     []session.Item
+		section  recentSection
+		activity time.Time
+		created  time.Time
+		id       string
+		project  string
+	}
+	var entries []*entry
+	var current *entry
+	var remote []session.Item
+	for _, item := range items {
+		if item.Type == session.ItemTypeWindow && current != nil {
+			current.rows = append(current.rows, item)
+			continue
+		}
+		if item.Type == session.ItemTypeRemoteSession {
+			remote = append(remote, item)
+		}
+		if item.Type != session.ItemTypeSession || item.Session == nil {
+			current = nil
+			continue
+		}
+		inst := item.Session
+		activity := h.sessionActivity(inst)
+		section := h.recentSectionFor(inst, activity)
+		// Only a chat with nothing running and nothing said is left out; a live
+		// chat can look empty for a moment while its conversation is re-read.
+		status := inst.GetStatusThreadSafe()
+		if section == recentPast && h.emptyConversations[inst.ID] && (status == session.StatusStopped || status == session.StatusError) && h.statusFilter != FilterModeArchived {
+			current = nil
+			continue
+		}
+		current = &entry{rows: []session.Item{item}, section: section, activity: activity, created: inst.CreatedAt, id: inst.ID, project: filepath.Clean(inst.ProjectPath)}
+		entries = append(entries, current)
+	}
+	sort.SliceStable(entries, func(i, j int) bool {
+		a, b := entries[i], entries[j]
+		if a.section != b.section {
+			return a.section < b.section
+		}
+		// Working rows keep their place while they stream output.
+		if a.section == recentWorking && !a.created.Equal(b.created) {
+			return a.created.After(b.created)
+		}
+		if !a.activity.Equal(b.activity) {
+			return a.activity.After(b.activity)
+		}
+		return a.id < b.id
+	})
+
+	counts := map[recentSection]int{}
+	for _, e := range entries {
+		counts[e.section]++
+	}
+	h.recentCounts = counts
+	out := make([]session.Item, 0, len(items)+3)
+	// Conversations that need you or are working stay on top across projects.
+	var projects []string
+	byProject := map[string][]*entry{}
+	for i, e := range entries {
+		if e.section == recentPast {
+			if byProject[e.project] == nil {
+				projects = append(projects, e.project)
+			}
+			byProject[e.project] = append(byProject[e.project], e)
+			continue
+		}
+		if i == 0 || entries[i-1].section != e.section {
+			out = append(out, session.Item{Type: session.ItemTypeDivider, DividerLabel: fmt.Sprintf("%s · %d", e.section.label(), counts[e.section])})
+		}
+		out = append(out, e.rows...)
+	}
+	// Everything else is grouped by project, newest project first, a few at a
+	// time; "Show more" reveals the next few.
+	if len(projects) > 0 && len(out) > 0 {
+		out = append(out, session.Item{Type: session.ItemTypeDivider, DividerLabel: recentPast.label()})
+	}
+	if h.recentProjectLimit == nil {
+		h.recentProjectLimit = map[string]int{}
+	}
+	h.recentProjectTotal = map[string]int{}
+	h.recentInProject = map[string]bool{}
+	for _, project := range projects {
+		group := byProject[project]
+		limit := h.recentProjectLimit[project]
+		if limit == 0 {
+			limit = recentProjectPage
+		}
+		h.recentProjectTotal[project] = len(group)
+		out = append(out, session.Item{Type: session.ItemTypeDivider, DividerLabel: filepath.Base(project), Path: project})
+		for _, e := range group[:min(limit, len(group))] {
+			h.recentInProject[e.id] = true
+			out = append(out, e.rows...)
+		}
+		if len(group) > limit {
+			out = append(out, session.Item{Type: session.ItemTypeShowMore, Path: project})
+		}
+	}
+	return append(out, remote...)
+}
+
+const recentProjectPage = 5
+
+// showMoreRecent reveals the next page of the selected project's
+// conversations and leaves the cursor on the first one it revealed.
+func (h *Home) showMoreRecent() {
+	if h.cursor < 0 || h.cursor >= len(h.flatItems) || h.flatItems[h.cursor].Type != session.ItemTypeShowMore {
+		return
+	}
+	project, at := h.flatItems[h.cursor].Path, h.cursor
+	if h.recentProjectLimit == nil {
+		h.recentProjectLimit = map[string]int{}
+	}
+	h.recentProjectLimit[project] = max(h.recentProjectLimit[project], recentProjectPage) + recentProjectPage
+	h.rebuildFlatItems()
+	h.cursor = min(at, max(0, len(h.flatItems)-1))
+	h.skipDivider(1)
+	h.syncViewport()
+}
+
+func (h *Home) renderProjectHeader(b *strings.Builder, item session.Item) {
+	name := lipgloss.NewStyle().Foreground(ColorCyan).Bold(true).Render(cellTruncate(item.DividerLabel, max(8, h.sessionsPaneWidth()-12), "…"))
+	b.WriteString("  " + name + DimStyle.Render(fmt.Sprintf(" · %d", h.recentProjectTotal[item.Path])) + "\n")
+}
+
+func (h *Home) renderShowMore(b *strings.Builder, item session.Item, selected bool, listWidth int) {
+	shown := h.recentProjectLimit[item.Path]
+	if shown == 0 {
+		shown = recentProjectPage
+	}
+	remaining := h.recentProjectTotal[item.Path] - shown
+	text := fmt.Sprintf("Show %d more", min(recentProjectPage, remaining))
+	if remaining > recentProjectPage {
+		text += fmt.Sprintf(" · %d older", remaining)
+	}
+	marker := "  "
+	if selected {
+		marker = "▶ "
+	}
+	line := fitCellWidth(strings.Repeat(" ", leftGutterWidth)+marker+"  "+text, max(1, listWidth))
+	if selected {
+		b.WriteString(lipgloss.NewStyle().Foreground(ColorText).Background(ColorSurface).Render(line) + "\n")
+		return
+	}
+	b.WriteString(lipgloss.NewStyle().Foreground(ColorAccent).Render(line) + "\n")
+}
+
+// conversationGlyph keeps alarm colours for things that need action. A saved
+// conversation that is simply not running shows no icon at all.
+func (h *Home) conversationGlyph(inst *session.Instance, state sessionRenderState) (string, lipgloss.Style) {
+	if inst.IsArchived() {
+		return " ", SessionStatusStopped
+	}
+	if state.substate == session.SubstateAuth401 {
+		return "🔒", SessionStatusWaiting
+	}
+	if limit, limited := h.limitFor(inst, state.substate); limited && limit.recent() {
+		return "!", SessionStatusError
+	}
+	if state.substate == session.SubstateInteractiveMenu {
+		return "!", SessionStatusWaiting
+	}
+	switch state.status {
+	case session.StatusRunning, session.StatusStarting:
+		return "●", SessionStatusRunning
+	case session.StatusWaiting:
+		if h.unreadDone(inst.ID) {
+			return "●", SessionStatusWaiting
+		}
+		return "○", SessionStatusIdle
+	case session.StatusIdle:
+		return "○", SessionStatusIdle
+	}
+	return " ", SessionStatusStopped
+}
+
+// conversationState is the plain-words status shown under the title.
+func (h *Home) conversationState(inst *session.Instance, state sessionRenderState) (string, lipgloss.Style) {
+	dim := lipgloss.NewStyle().Foreground(ColorTextDim)
+	if limit, limited := h.limitFor(inst, state.substate); limited {
+		switch {
+		case !limit.recent():
+			return "stopped by limit", SessionStatusError.Faint(true)
+		case limit.resets != "":
+			return "limit · resets " + limit.resets, SessionStatusError
+		}
+		return "limit reached", SessionStatusError
+	}
+	if !inst.IsArchived() {
+		switch state.substate {
+		case session.SubstateInteractiveMenu:
+			return "waiting for you", SessionStatusWaiting
+		case session.SubstateAuth401:
+			return "sign-in needed", SessionStatusWaiting
+		}
+	}
+	age := shortAge(h.sessionActivity(inst), time.Now())
+	switch state.status {
+	case session.StatusRunning, session.StatusStarting:
+		return "working", SessionStatusRunning
+	case session.StatusWaiting:
+		if h.unreadDone(inst.ID) {
+			return "done " + age, SessionStatusWaiting
+		}
+	}
+	return age, dim
+}
+
+func shortAge(t, now time.Time) string {
+	if t.IsZero() {
+		return ""
+	}
+	d := now.Sub(t)
+	switch {
+	case d < time.Minute:
+		return "now"
+	case d < time.Hour:
+		return fmt.Sprintf("%dm", int(d/time.Minute))
+	case d < 24*time.Hour:
+		return fmt.Sprintf("%dh", int(d/time.Hour))
+	case d < 7*24*time.Hour:
+		return fmt.Sprintf("%dd", int(d/(24*time.Hour)))
+	case t.Year() == now.Year():
+		return t.Format("Jan 2")
+	}
+	return t.Format("Jan 2006")
+}
+
+// Conversation titles come from the agent: Claude's own generated title (the
+// one its desktop app shows), a /rename, or the Codex thread name. A title the
+// user typed in Agent Deck locks the row and is never replaced.
+const nativeTitleSyncInterval = 5 * time.Second
+
+type nativeTitleCandidate struct {
+	id      string
+	title   string
+	locked  bool
+	created time.Time
+	input   session.NativeConversationInput
+}
+
+type nativeTitleSyncMsg struct {
+	titles  map[string]string
+	empty   map[string]bool
+	limits  map[string]conversationLimit
+	changed map[string]time.Time
+	// read lists the chats whose conversation could be read this round;
+	// for the rest the last known state stands.
+	read map[string]bool
+}
+
+func (h *Home) placeholderTitle(title, project, account string) bool {
+	title = strings.TrimSpace(title)
+	if session.PlaceholderSessionTitle(title) || title == filepath.Base(filepath.Clean(project)) {
+		return true
+	}
+	label := sidebarAccountLabels[account].Name
+	return title == account || (label != "" && (title == label || strings.HasPrefix(title, label+" ")))
+}
+
+func (h *Home) startNativeTitleSync(now time.Time) tea.Cmd {
+	if h.nativeTitleSyncRunning || now.Sub(h.nativeTitleSyncAt) < nativeTitleSyncInterval {
+		return nil
+	}
+	h.instancesMu.RLock()
+	candidates := make([]nativeTitleCandidate, 0, len(h.instances))
+	for _, inst := range h.instances {
+		if inst == nil || inst.IsArchived() || inst.SSHHost != "" {
+			continue
+		}
+		if !session.IsClaudeCompatible(inst.Tool) && !session.IsCodexCompatible(inst.Tool) {
+			continue
+		}
+		title := inst.GetTitleThreadSafe()
+		candidates = append(candidates, nativeTitleCandidate{
+			id:      inst.ID,
+			title:   title,
+			locked:  inst.TitleLocked && !h.placeholderTitle(title, inst.ProjectPath, inst.GetAccountThreadSafe()),
+			created: inst.CreatedAt,
+			input:   session.NativeConversationInputFor(inst),
+		})
+	}
+	h.instancesMu.RUnlock()
+	h.nativeTitleSyncRunning = true
+	h.nativeTitleSyncAt = now
+	return func() tea.Msg {
+		msg := nativeTitleSyncMsg{titles: map[string]string{}, empty: map[string]bool{}, limits: map[string]conversationLimit{}, changed: map[string]time.Time{}, read: map[string]bool{}}
+		for _, c := range candidates {
+			native := session.NativeConversationFor(c.input)
+			// Agent Deck briefly clears a running chat's conversation id while
+			// it re-reads it; that is not news about the conversation.
+			if native.Known && (c.input.ClaudeSessionID != "" || c.input.CodexSessionID != "") {
+				msg.read[c.id] = true
+			}
+			if !native.Changed.IsZero() {
+				msg.changed[c.id] = native.Changed
+			}
+			if !native.LimitedAt.IsZero() && native.LimitedAt.After(c.created) {
+				msg.limits[c.id] = conversationLimit{at: native.LimitedAt, resets: native.LimitResets}
+			}
+			if native.Known && native.Empty {
+				msg.empty[c.id] = true
+			}
+			if !c.locked && native.Title != "" && native.Title != c.title {
+				msg.titles[c.id] = native.Title
+			}
+		}
+		return msg
+	}
+}
+
+func (h *Home) applyNativeTitleSync(msg nativeTitleSyncMsg) {
+	h.nativeTitleSyncRunning = false
+	h.emptyConversations = msg.empty
+	for id, limit := range h.conversationLimits {
+		if _, exists := h.instanceByID[id]; exists && !msg.read[id] {
+			msg.limits[id] = limit
+		}
+	}
+	for id, changed := range h.conversationChanged {
+		if _, exists := h.instanceByID[id]; exists && !msg.read[id] {
+			if _, fresh := msg.changed[id]; !fresh {
+				msg.changed[id] = changed
+			}
+		}
+	}
+	h.conversationLimits = msg.limits
+	h.conversationChanged = msg.changed
+	changed := false
+	for id, title := range msg.titles {
+		inst := h.instanceByID[id]
+		if inst == nil || inst.GetTitleThreadSafe() == title {
+			continue
+		}
+		if inst.TitleLocked && !h.placeholderTitle(inst.GetTitleThreadSafe(), inst.ProjectPath, inst.GetAccountThreadSafe()) {
+			continue
+		}
+		inst.SetTitleThreadSafe(title)
+		inst.TitleLocked = false
+		inst.SyncTmuxDisplayName()
+		h.invalidatePreviewCache(id)
+		changed = true
+	}
+	if changed {
+		h.saveInstances()
+		h.refreshSessionRenderSnapshot(nil)
+	}
+	if h.sidebarMode == sidebarFlat || changed {
+		h.rebuildFlatItemsPreservingSelection(h.captureSelectedItemIdentity())
+	}
+}
+
+// Seen, like a conversation clicked in the desktop app: a finished chat is
+// seen while it is open in a panel and stays seen until it finishes again.
+// Kept here rather than in Agent Deck's own status, which marks a chat unseen
+// again whenever its screen changes (typing in it counts).
+func (h *Home) trackSeen(now time.Time) {
+	if h.waitingSince == nil {
+		h.waitingSince, h.panelSeenAt = map[string]time.Time{}, map[string]time.Time{}
+	}
+	h.instancesMu.RLock()
+	defer h.instancesMu.RUnlock()
+	for _, inst := range h.instances {
+		if inst == nil {
+			continue
+		}
+		if inst.GetStatusThreadSafe() == session.StatusWaiting {
+			if _, known := h.waitingSince[inst.ID]; !known {
+				h.waitingSince[inst.ID] = now
+			}
+		} else if inst.GetStatusThreadSafe() != session.StatusIdle {
+			delete(h.waitingSince, inst.ID)
+		}
+		if _, open := h.conversationPanel(inst); open {
+			h.panelSeenAt[inst.ID] = now
+		}
+	}
+}
+
+// unreadDone reports a finished chat nobody has had open since it finished.
+func (h *Home) unreadDone(id string) bool {
+	since, waiting := h.waitingSince[id]
+	return waiting && h.panelSeenAt[id].Before(since)
+}
+
+func recentSectionLabelStyle(label string) lipgloss.Style {
+	style := lipgloss.NewStyle().Bold(true)
+	switch {
+	case strings.HasPrefix(label, recentNeedsYou.label()):
+		return style.Foreground(ColorYellow)
+	case strings.HasPrefix(label, recentWorking.label()):
+		return style.Foreground(ColorGreen)
+	}
+	return style.Foreground(ColorText)
+}
+
+// renderRecentSummary replaces the status-filter pills on the Recent view with
+// the two numbers that matter: how many conversations need you, and how many
+// are still working.
+func (h *Home) renderRecentSummary() string {
+	pill := lipgloss.NewStyle().Padding(0, 1)
+	parts := []string{pill.Foreground(ColorBg).Background(ColorAccent).Bold(true).Render("Recent")}
+	if n := h.recentCounts[recentNeedsYou]; n > 0 {
+		parts = append(parts, pill.Foreground(ColorYellow).Background(ColorSurface).Render(fmt.Sprintf("● %d need you", n)))
+	}
+	if n := h.recentCounts[recentWorking]; n > 0 {
+		parts = append(parts, pill.Foreground(ColorGreen).Background(ColorSurface).Render(fmt.Sprintf("● %d working", n)))
+	}
+	if len(parts) == 1 {
+		parts = append(parts, pill.Foreground(ColorTextDim).Render("All quiet"))
+	}
+	return lipgloss.NewStyle().MaxWidth(h.width).Render(" " + strings.Join(parts, " "))
+}
