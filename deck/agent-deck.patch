diff --git a/internal/ui/workspace_panel.go b/internal/ui/workspace_panel.go
new file mode 100644
index 0000000..8fb171a
--- /dev/null
+++ b/internal/ui/workspace_panel.go
@@ -0,0 +1,143 @@
+package ui
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	tea "github.com/charmbracelet/bubbletea"
+
+	"github.com/asheshgoplani/agent-deck/internal/session"
+)
+
+type workspacePanelOpenedMsg struct{ err error }
+
+var workspaceNamePattern = regexp.MustCompile(`^claude-desk(?:-\d+)?$`)
+
+// deckFolder holds the deck's programs and the panels' records.
+func deckFolder() string {
+	if folder := os.Getenv("AGENT_DECK_HOME"); folder != "" {
+		return folder
+	}
+	home, _ := os.UserHomeDir()
+	return filepath.Join(home, ".config", "agent-deck")
+}
+
+func workspacePanelCommand(id string) tea.Cmd {
+	workspace := os.Getenv("AGENT_DECK_WORKSPACE")
+	if !workspaceNamePattern.MatchString(workspace) {
+		return nil
+	}
+	return func() tea.Msg {
+		ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+		defer cancel()
+		command := exec.CommandContext(ctx, filepath.Join(deckFolder(), "workspace.js"), "open-chat", id, "--workspace", workspace)
+		output, err := command.Output()
+		if err != nil {
+			message := strings.TrimSpace(string(output))
+			if message == "" {
+				message = "Could not open this conversation. Try again."
+			}
+			return workspacePanelOpenedMsg{err: fmt.Errorf("%s", message)}
+		}
+		return workspacePanelOpenedMsg{}
+	}
+}
+
+// workspacePanel is a chat panel of an Agent Deck workspace window.
+type workspacePanel struct {
+	workspace string
+	slot      int
+}
+
+var workspacePanels struct {
+	sync.Mutex
+	byTTY      map[string]workspacePanel
+	refreshing bool
+	nextAt     time.Time
+}
+
+// workspacePanelForTTY maps a tmux client terminal to the workspace panel it
+// is drawn in. The listing refreshes in the background, so a render never
+// waits on tmux.
+func workspacePanelForTTY(tty string) (workspacePanel, bool) {
+	workspacePanels.Lock()
+	defer workspacePanels.Unlock()
+	if !workspacePanels.refreshing && !time.Now().Before(workspacePanels.nextAt) {
+		workspacePanels.refreshing = true
+		go refreshWorkspacePanels()
+	}
+	panel, ok := workspacePanels.byTTY[tty]
+	return panel, ok
+}
+
+// refreshWorkspacePanels reads the panels' records: each running panel notes
+// its terminal there.
+func refreshWorkspacePanels() {
+	byTTY := map[string]workspacePanel{}
+	root := filepath.Join(deckFolder(), "panels")
+	workspaces, _ := os.ReadDir(root)
+	for _, entry := range workspaces {
+		if !entry.IsDir() || !workspaceNamePattern.MatchString(entry.Name()) {
+			continue
+		}
+		for slot := 1; slot <= 6; slot++ {
+			data, err := os.ReadFile(filepath.Join(root, entry.Name(), fmt.Sprintf("%d.json", slot)))
+			if err != nil {
+				continue
+			}
+			var record struct {
+				TTY string `json:"tty"`
+				PID int    `json:"pid"`
+			}
+			if json.Unmarshal(data, &record) != nil || record.TTY == "" || record.PID <= 0 {
+				continue
+			}
+			if err := syscall.Kill(record.PID, 0); err != nil && !errors.Is(err, syscall.EPERM) {
+				continue
+			}
+			byTTY[record.TTY] = workspacePanel{workspace: entry.Name(), slot: slot}
+		}
+	}
+	workspacePanels.Lock()
+	workspacePanels.byTTY = byTTY
+	workspacePanels.refreshing = false
+	workspacePanels.nextAt = time.Now().Add(2 * time.Second)
+	workspacePanels.Unlock()
+}
+
+// conversationPanel names the workspace panel a conversation is open in.
+func (h *Home) conversationPanel(inst *session.Instance) (string, bool) {
+	viewers, known := inst.ViewersCached()
+	if !known {
+		return "", false
+	}
+	current := os.Getenv("AGENT_DECK_WORKSPACE")
+	label, found := "", false
+	for _, viewer := range viewers {
+		panel, ok := workspacePanelForTTY(viewer.TTY)
+		if !ok {
+			continue
+		}
+		if panel.workspace == current {
+			return fmt.Sprintf("panel %d", panel.slot), true
+		}
+		if !found {
+			number := "1"
+			if index := strings.LastIndex(panel.workspace, "-"); index > 0 && panel.workspace != "claude-desk" {
+				number = panel.workspace[index+1:]
+			}
+			label, found = fmt.Sprintf("deck %s panel %d", number, panel.slot), true
+		}
+	}
+	return label, found
+}
