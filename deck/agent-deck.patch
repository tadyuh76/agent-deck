diff --git a/internal/ui/deck_preview.go b/internal/ui/deck_preview.go
new file mode 100644
index 0000000..2b2cfcb
--- /dev/null
+++ b/internal/ui/deck_preview.go
@@ -0,0 +1,522 @@
+package ui
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/charmbracelet/lipgloss"
+	"github.com/charmbracelet/x/ansi"
+
+	"github.com/asheshgoplani/agent-deck/internal/session"
+)
+
+// The preview in an Agent Deck window. The panels already show the chats
+// themselves, so the preview answers what the list cannot: where a chat
+// stands, where it is open, what you last asked and what the agent last said
+// or is doing now. It reads the chat's own transcript, in the background.
+
+// chatGlance is the latest exchange of a conversation.
+type chatGlance struct {
+	prompt   string // your last message
+	promptAt time.Time
+	reply    string // the agent's latest words since that message
+	doing    string // the step it took after its latest words
+}
+
+type glanceEntry struct {
+	path       string
+	resolvedAt time.Time
+	modTime    time.Time
+	size       int64
+	glance     chatGlance
+	known      bool
+	checkedAt  time.Time
+	loading    bool
+}
+
+var chatGlances = struct {
+	sync.Mutex
+	byID map[string]*glanceEntry
+}{byID: map[string]*glanceEntry{}}
+
+// glanceTail is how much of the end of a transcript is read.
+const glanceTail = 1 << 20
+
+// inDeckWindow reports whether this list is the left side of a deck window.
+func inDeckWindow() bool {
+	return workspaceNamePattern.MatchString(os.Getenv("AGENT_DECK_WORKSPACE"))
+}
+
+// glanceFor returns what is known of a conversation now, and starts a fresh
+// read when the last one is more than a moment old. It never touches the
+// filesystem itself, so rendering never waits.
+func glanceFor(inst *session.Instance) (chatGlance, bool) {
+	chatGlances.Lock()
+	defer chatGlances.Unlock()
+	entry := chatGlances.byID[inst.ID]
+	if entry == nil {
+		entry = &glanceEntry{}
+		chatGlances.byID[inst.ID] = entry
+	}
+	if !entry.loading && time.Since(entry.checkedAt) > 1500*time.Millisecond {
+		entry.loading = true
+		go refreshGlance(inst, entry)
+	}
+	return entry.glance, entry.known
+}
+
+func refreshGlance(inst *session.Instance, entry *glanceEntry) {
+	chatGlances.Lock()
+	path, resolvedAt, modTime, size := entry.path, entry.resolvedAt, entry.modTime, entry.size
+	chatGlances.Unlock()
+
+	if path == "" || time.Since(resolvedAt) > 30*time.Second {
+		if found := session.ListedTranscriptPath(inst); found != "" {
+			path = found
+		} else if session.IsClaudeCompatible(inst.Tool) {
+			path = inst.GetJSONLPath()
+		}
+		resolvedAt = time.Now()
+	}
+	glance, known, changed := chatGlance{}, false, false
+	if info, err := os.Stat(path); path != "" && err == nil {
+		if !info.ModTime().Equal(modTime) || info.Size() != size {
+			glance, known = readGlance(path, info.Size())
+			modTime, size, changed = info.ModTime(), info.Size(), true
+		}
+	} else {
+		changed = true
+	}
+
+	chatGlances.Lock()
+	entry.path, entry.resolvedAt, entry.modTime, entry.size = path, resolvedAt, modTime, size
+	if changed {
+		entry.glance, entry.known = glance, known
+	}
+	entry.checkedAt, entry.loading = time.Now(), false
+	chatGlances.Unlock()
+}
+
+// transcriptLine holds the fields of a Claude or Codex transcript line the
+// preview uses.
+type transcriptLine struct {
+	Type        string    `json:"type"`
+	LastPrompt  string    `json:"lastPrompt"`
+	IsMeta      bool      `json:"isMeta"`
+	IsSidechain bool      `json:"isSidechain"`
+	Timestamp   time.Time `json:"timestamp"`
+	Origin      *struct {
+		Kind string `json:"kind"`
+	} `json:"origin"`
+	Message *struct {
+		Role    string          `json:"role"`
+		Content json.RawMessage `json:"content"`
+	} `json:"message"`
+	Attachment *struct {
+		Type   string `json:"type"`
+		Prompt string `json:"prompt"`
+	} `json:"attachment"`
+	Payload *struct {
+		Type    string          `json:"type"`
+		Role    string          `json:"role"`
+		Message string          `json:"message"`
+		Name    string          `json:"name"`
+		Content json.RawMessage `json:"content"`
+	} `json:"payload"`
+}
+
+type contentBlock struct {
+	Type  string          `json:"type"`
+	Text  string          `json:"text"`
+	Name  string          `json:"name"`
+	Input json.RawMessage `json:"input"`
+}
+
+func readGlance(path string, size int64) (chatGlance, bool) {
+	file, err := os.Open(path)
+	if err != nil {
+		return chatGlance{}, false
+	}
+	defer file.Close()
+	offset := max(int64(0), size-glanceTail)
+	if _, err := file.Seek(offset, io.SeekStart); err != nil {
+		return chatGlance{}, false
+	}
+	reader := bufio.NewReaderSize(file, 256*1024)
+	if offset > 0 {
+		_, _ = reader.ReadBytes('\n') // a partial line
+	}
+	var g chatGlance
+	lastPrompt := ""
+	for {
+		raw, err := reader.ReadBytes('\n')
+		if len(bytes.TrimSpace(raw)) > 0 {
+			var line transcriptLine
+			if json.Unmarshal(raw, &line) == nil {
+				lastPrompt = g.take(line, lastPrompt)
+			}
+		}
+		if err != nil {
+			break
+		}
+	}
+	if g.prompt == "" {
+		g.prompt = cleanPrompt(lastPrompt)
+	}
+	return g, g.prompt != "" || g.reply != "" || g.doing != ""
+}
+
+// take folds one transcript line into the glance.
+func (g *chatGlance) take(line transcriptLine, lastPrompt string) string {
+	switch line.Type {
+	case "last-prompt":
+		return line.LastPrompt
+	case "user":
+		if line.IsMeta || line.IsSidechain || line.Message == nil {
+			return lastPrompt
+		}
+		human := line.Origin != nil && line.Origin.Kind == "human"
+		text, isText := plainContent(line.Message.Content)
+		if !human && !isText {
+			return lastPrompt
+		}
+		if prompt := cleanPrompt(text); prompt != "" {
+			*g = chatGlance{prompt: prompt, promptAt: line.Timestamp}
+		}
+	case "attachment": // a message sent while the agent was working
+		if line.IsSidechain || line.Attachment == nil || line.Attachment.Type != "queued_command" {
+			return lastPrompt
+		}
+		if prompt := cleanPrompt(line.Attachment.Prompt); prompt != "" {
+			*g = chatGlance{prompt: prompt, promptAt: line.Timestamp}
+		}
+	case "assistant":
+		if line.IsSidechain || line.Message == nil {
+			return lastPrompt
+		}
+		var blocks []contentBlock
+		if json.Unmarshal(line.Message.Content, &blocks) != nil {
+			return lastPrompt
+		}
+		for _, block := range blocks {
+			switch block.Type {
+			case "text":
+				if text := strings.TrimSpace(block.Text); text != "" {
+					g.reply, g.doing = text, ""
+				}
+			case "tool_use":
+				g.doing = describeStep(block.Name, block.Input)
+			}
+		}
+	case "event_msg": // Codex
+		if line.Payload == nil {
+			return lastPrompt
+		}
+		switch line.Payload.Type {
+		case "user_message":
+			if prompt := cleanPrompt(line.Payload.Message); prompt != "" {
+				*g = chatGlance{prompt: prompt, promptAt: line.Timestamp}
+			}
+		case "agent_message":
+			if text := strings.TrimSpace(line.Payload.Message); text != "" {
+				g.reply, g.doing = text, ""
+			}
+		}
+	case "response_item": // Codex
+		if line.Payload != nil && line.Payload.Type == "function_call" {
+			g.doing = describeStep(line.Payload.Name, nil)
+		}
+	}
+	return lastPrompt
+}
+
+// plainContent is a user message's typed text; false for tool results.
+func plainContent(raw json.RawMessage) (string, bool) {
+	var text string
+	if json.Unmarshal(raw, &text) == nil {
+		return text, true
+	}
+	var blocks []contentBlock
+	if json.Unmarshal(raw, &blocks) != nil {
+		return "", false
+	}
+	var parts []string
+	for _, block := range blocks {
+		switch block.Type {
+		case "tool_result":
+			return "", false
+		case "text":
+			parts = append(parts, block.Text)
+		}
+	}
+	return strings.Join(parts, "\n"), len(parts) > 0
+}
+
+var (
+	imageTag     = regexp.MustCompile(`\[Image #\d+\]`)
+	commandName  = regexp.MustCompile(`<command-name>([^<]*)</command-name>`)
+	commandArgs  = regexp.MustCompile(`<command-args>([^<]*)</command-args>`)
+	markdownLink = regexp.MustCompile(`\[([^\]]+)\]\([^)]+\)`)
+	markdownMark = regexp.MustCompile("\\*\\*|__|`")
+	heading      = regexp.MustCompile(`^#{1,6}\s+`)
+	bullet       = regexp.MustCompile(`^(\s*)[-*]\s+`)
+)
+
+// cleanPrompt is a message as you typed it; "" for messages the app sent.
+func cleanPrompt(text string) string {
+	text = strings.TrimSpace(text)
+	if name := commandName.FindStringSubmatch(text); name != nil {
+		args := ""
+		if found := commandArgs.FindStringSubmatch(text); found != nil {
+			args = " " + strings.TrimSpace(found[1])
+		}
+		return strings.TrimSpace(name[1] + args)
+	}
+	if text == "" || strings.HasPrefix(text, "<") || strings.HasPrefix(text, "[Request interrupted") || strings.HasPrefix(text, "[Image: source:") {
+		return ""
+	}
+	return strings.TrimSpace(imageTag.ReplaceAllString(text, "[image]"))
+}
+
+// cleanReply turns the agent's Markdown into plain lines.
+func cleanReply(text string) []string {
+	var lines []string
+	fenced, blank := false, false
+	for _, line := range strings.Split(text, "\n") {
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "```") {
+			fenced = !fenced
+			continue
+		}
+		if !fenced {
+			line = heading.ReplaceAllString(line, "")
+			line = bullet.ReplaceAllString(line, "$1• ")
+			line = markdownLink.ReplaceAllString(line, "$1")
+			line = markdownMark.ReplaceAllString(line, "")
+		}
+		line = strings.TrimRight(line, " \t")
+		if line == "" || strings.Trim(line, "-|: ") == "" {
+			if !blank && len(lines) > 0 {
+				lines = append(lines, "")
+			}
+			blank = true
+			continue
+		}
+		lines, blank = append(lines, line), false
+	}
+	for len(lines) > 0 && lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	return lines
+}
+
+// describeStep says in a few words what a tool step does.
+func describeStep(name string, input json.RawMessage) string {
+	var args struct {
+		Description string `json:"description"`
+		FilePath    string `json:"file_path"`
+		Query       string `json:"query"`
+		Pattern     string `json:"pattern"`
+		Skill       string `json:"skill"`
+		URL         string `json:"url"`
+	}
+	_ = json.Unmarshal(input, &args)
+	file := filepath.Base(args.FilePath)
+	switch {
+	case args.Description != "":
+		return args.Description
+	case name == "Read" && args.FilePath != "":
+		return "Reading " + file
+	case (name == "Edit" || name == "MultiEdit") && args.FilePath != "":
+		return "Editing " + file
+	case name == "Write" && args.FilePath != "":
+		return "Writing " + file
+	case name == "WebSearch" && args.Query != "":
+		return "Searching the web: " + args.Query
+	case name == "WebFetch":
+		return "Reading a web page"
+	case name == "Grep" || name == "Glob":
+		return "Searching the code"
+	case name == "TodoWrite":
+		return "Updating its plan"
+	case name == "Skill" && args.Skill != "":
+		return "Using " + args.Skill
+	case strings.HasPrefix(name, "mcp__"):
+		parts := strings.Split(name, "__")
+		return "Using " + strings.ReplaceAll(parts[len(parts)-1], "_", " ")
+	case name == "exec_command" || name == "shell":
+		return "Running a command"
+	}
+	return name
+}
+
+// wrapParagraphs word-wraps each line to width.
+func wrapParagraphs(lines []string, width int) []string {
+	var out []string
+	for _, line := range lines {
+		if line == "" {
+			out = append(out, "")
+			continue
+		}
+		indent := ""
+		if strings.HasPrefix(strings.TrimLeft(line, " "), "• ") {
+			indent = strings.Repeat(" ", ansi.StringWidth(line)-ansi.StringWidth(strings.TrimLeft(line, " "))+2)
+		}
+		for i, part := range strings.Split(ansi.Wrap(line, max(4, width-len(indent)), ""), "\n") {
+			if i > 0 {
+				part = indent + strings.TrimLeft(part, " ")
+			}
+			out = append(out, part)
+		}
+	}
+	return out
+}
+
+func ago(t time.Time) string {
+	age := shortAge(t, time.Now())
+	switch {
+	case age == "":
+		return ""
+	case age == "now":
+		return "just now"
+	case strings.ContainsAny(age[len(age)-1:], "mhd") && age[0] >= '0' && age[0] <= '9':
+		return age + " ago"
+	}
+	return age
+}
+
+// renderDeckPreview draws the selected conversation's preview.
+func (h *Home) renderDeckPreview(inst *session.Instance, width, height int) string {
+	width = max(10, width-1)
+	state := h.getSessionRenderState(inst)
+	dim := lipgloss.NewStyle().Foreground(ColorTextDim)
+	label := lipgloss.NewStyle().Foreground(ColorTextDim).Bold(true)
+	var top []string
+
+	// The conversation's name.
+	title := strings.TrimSpace(state.title)
+	if title == "" {
+		title = inst.Title
+	}
+	for i, line := range wrapParagraphs([]string{title}, width) {
+		if i == 2 {
+			top[1] = ansi.Truncate(top[1], width-1, "") + "…"
+			break
+		}
+		top = append(top, lipgloss.NewStyle().Bold(true).Foreground(ColorAccent).Render(line))
+	}
+
+	// Where it stands, and where it is open.
+	glyph, glyphStyle := h.conversationGlyph(inst, state)
+	words, wordsStyle := h.conversationState(inst, state)
+	switch {
+	case inst.IsArchived():
+		words, wordsStyle = "archived", dim
+	case words == "working" || strings.HasPrefix(words, "done") || strings.Contains(words, "limit") || words == "waiting for you" || words == "sign-in needed":
+	case state.status == session.StatusStopped || state.status == session.StatusError:
+		words, wordsStyle = "stopped · "+ago(h.sessionActivity(inst)), dim
+	default:
+		words, wordsStyle = "idle · "+ago(h.sessionActivity(inst)), dim
+	}
+	status := wordsStyle.Render(words)
+	if glyph = strings.TrimSpace(glyph); glyph != "" {
+		status = glyphStyle.Render(glyph) + " " + status
+	}
+	if panel, open := h.conversationPanel(inst); open {
+		status += dim.Render(" · ") + lipgloss.NewStyle().Foreground(ColorAccent).Render("in "+panel)
+	}
+	top = append(top, ansi.Truncate(status, width, "…"))
+
+	// Account and project.
+	var where []string
+	if account, ok := sidebarAccountLabels[state.account]; ok && account.Name != "" {
+		style := lipgloss.NewStyle()
+		if account.Color != "" {
+			style = style.Foreground(lipgloss.Color(account.Color))
+		}
+		where = append(where, style.Render(account.Name))
+	} else if state.account != "" {
+		where = append(where, state.account)
+	}
+	if inst.ProjectPath != "" {
+		where = append(where, dim.Render(filepath.Base(inst.ProjectPath)))
+	}
+	if len(where) > 0 {
+		top = append(top, ansi.Truncate(strings.Join(where, dim.Render(" · ")), width, "…"))
+	}
+	if line := backgroundWorkLine(inst.BackgroundWork()); line != "" {
+		top = append(top, lipgloss.NewStyle().Foreground(ColorGreen).Render(ansi.Truncate(line, width, "…")))
+	}
+
+	glance, known := glanceFor(inst)
+	if !known {
+		top = append(top, "", dim.Render("Nothing said in this chat yet."))
+		return strings.Join(top, "\n")
+	}
+
+	// What you last asked: up to four lines.
+	room := height - len(top)
+	var you []string
+	if glance.prompt != "" && room > 4 {
+		head := label.Render("You")
+		if when := ago(glance.promptAt); when != "" {
+			head += dim.Render(" · " + when)
+		}
+		body := wrapParagraphs(strings.Split(glance.prompt, "\n"), width-2)
+		limit := min(4, max(1, room/3))
+		if len(body) > limit {
+			body = append(body[:limit-1], ansi.Truncate(body[limit-1], width-3, "")+"…")
+		}
+		you = append([]string{"", head}, indentAll(body)...)
+	}
+
+	// What the agent is doing now, while it works.
+	working := state.status == session.StatusRunning || state.status == session.StatusStarting
+	var now []string
+	if working && glance.doing != "" {
+		now = []string{"", lipgloss.NewStyle().Foreground(ColorGreen).Render(ansi.Truncate("↳ "+glance.doing, width, "…"))}
+	}
+
+	// Its latest words, ending where it stopped.
+	var reply []string
+	if body := wrapParagraphs(cleanReply(glance.reply), width-2); len(body) > 0 {
+		agent := "Claude"
+		if session.IsCodexCompatible(inst.Tool) {
+			agent = "Codex"
+		}
+		space := height - len(top) - len(you) - len(now) - 2
+		if space >= 1 {
+			if len(body) > space {
+				body = append([]string{dim.Render("…")}, body[len(body)-space+1:]...)
+			}
+			reply = append([]string{"", label.Render(agent)}, indentAll(body)...)
+		}
+	} else if working && len(now) == 0 {
+		now = []string{"", dim.Render("Working on it…")}
+	}
+
+	lines := append(append(append(top, you...), reply...), now...)
+	if len(lines) > height {
+		lines = lines[:height]
+	}
+	return strings.Join(lines, "\n")
+}
+
+func indentAll(lines []string) []string {
+	out := make([]string, len(lines))
+	for i, line := range lines {
+		if line != "" {
+			line = "  " + line
+		}
+		out[i] = line
+	}
+	return out
+}
